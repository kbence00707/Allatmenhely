# Copy this file to ".env" (in the same backend folder) and adjust the values.
# The ".env" file is NOT uploaded to GitHub, so passwords stay on your computer.
# If there is no ".env" file, the defaults below (XAMPP defaults) are used.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=allatmenhely
DB_USER=root
DB_PASS=

# Other websites (origins) allowed to call the API, separated by commas.
# Needed only if you open the frontend from somewhere other than http://localhost
# (for example the VS Code "Live Server" extension on port 5500).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Shelter opening hours: visitors can only book appointments in this range.
OPENING_TIME=09:00
CLOSING_TIME=17:00

TIMEZONE=Europe/Budapest

# true = show detailed error messages (only for local debugging!)
APP_DEBUG=false
